SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=your-smtp-app-password

SMTP_FROM=

# Admin API (local testing)
# Set a strong secret in production.
# If ADMIN_MODE=dev, auth is disabled for quick local testing.
ADMIN_KEY=change-me
ADMIN_PORT=8787
ADMIN_MODE=prod
